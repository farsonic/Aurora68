# the Aurora68 Agent's (mac/piagent)
mac/build/ag/
mac/build/piagent.elf

# local working copies made for parallel work (git worktrees), never part of the repository
.claude/worktrees/
# the FAT/exFAT HFS view test (tools/hfsview_test.sh): its images and trees are never committed
mac/build/hfsview/

# Aurora68 Play for macOS: SwiftPM and make-app.sh outputs
macos/Aurora68Play/.build/
macos/Aurora68Play/build/
macos/Aurora68Play/.swiftpm/

# local copies at the top of the tree: ROMs, disk images, the M0110A keyboard's ROM set, MAME's
# per-run directories when started from here, and the testbed runs' logs and screenshots
/*.rom
/*.image
/*.hda
/*.zip
/cfg/
/nvram/
/runs/
