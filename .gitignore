# large or copyrighted inputs are never committed
reference/mame/
rom/original/*.rom
rom/patched/*.rom
*.dis
mame/roms/
mame/roms_*/
mame/snap*/
mame/cfg*/
mame/nvram*/
mame/*.txt
images/
snap/
diff/
# build outputs and logs
psmac-build/
emu68-build/
*.log
error.log
__pycache__/
# third-party reference checkouts (see reference/README.md)
reference/*
!reference/README.md
!reference/mame-psmac.patch
!reference/mame-src/

# the kernel tree is vendored; its build directories are not
emu68/build/
dist/
# intermediates of the C programs in mac/ (mac/c: crt0, the generated Toolbox glue, objects);
# the applications themselves (mac/build/*.bin) are committed
mac/build/crt0.o
mac/build/libc.o
mac/build/toolbox_gen.h
mac/build/toolbox_glue.o
mac/build/toolbox_glue.s
mac/build/pilog.o
mac/build/pilog.elf
mac/build/pidepth.o
mac/build/pidepth.elf
