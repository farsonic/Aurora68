# SPDX-License-Identifier: MPL-2.0
#
# aurora68.config - the Linux kernel's configuration for Aurora68, as a fragment over
# arch/m68k/configs/mac_defconfig (28 November 2026, docs/27-linux.md).
#
# The kernel is started by Aurora68's own kernel (mac.linux=vmlinux in cmdline.txt), which presents a
# Macintosh IIci with a 68030 and a 68882 (mac.mmu=full) and hands Linux a Macintosh bootinfo. Everything
# the machine needs to reach its root disk, its screen, its keyboard and its network is built in: there is
# no initramfs and no module tree on the disk, so modules are switched off altogether and what mac_defconfig
# had as a module and a small Debian system wants is made =y here. Used by tools/linux/build-debian-image.sh
# (scripts/kconfig/merge_config.sh mac_defconfig + this file, then make olddefconfig).

CONFIG_LOCALVERSION="-aurora68"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_MODULES=n

# the processor Aurora68 presents with mac.mmu=full
CONFIG_M68020=n
CONFIG_M68030=y
CONFIG_M68040=n
CONFIG_M68060=n
CONFIG_M68KFPU_EMU=n
CONFIG_MAC=y

# the root disk: the IIci's NCR 5380 (Aurora68's virtual SCSI disk, scsi.disk=NAME:ID), ext4 on the whole disk
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_MAC_SCSI=y
CONFIG_CHR_DEV_SG=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# the screen: the slot 9 card's frame buffer (the SE's own screen, or the HDMI screen) and a console on it
CONFIG_FB=y
CONFIG_FB_MAC=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONTS=y
CONFIG_FONT_6x11=y
CONFIG_FONT_8x16=y
CONFIG_LOGO=y

# the keyboard and mouse: ADB through VIA1 (the SE's own, and the Pi's as virtual ADB devices)
CONFIG_ADB=y
CONFIG_ADB_MACII=y
CONFIG_INPUT_ADBHID=y
CONFIG_MAC_EMUMOUSEBTN=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MOUSEDEV=y

# the serial ports: the SCC, channel A as ttyS0, with a console on it
CONFIG_SERIAL_PMACZILOG=y
CONFIG_SERIAL_PMACZILOG_TTYS=y
CONFIG_SERIAL_PMACZILOG_CONSOLE=y
CONFIG_EARLY_PRINTK=y

# the network: the DP8390 NuBus card Aurora68 presents with mac.auxnet=on (board ID 8, slot $D)
CONFIG_NET_VENDOR_8390=y
CONFIG_MAC8390=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y

# what Debian's userland expects of a kernel
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_UNIX98_PTYS=y
CONFIG_FHANDLE=y
CONFIG_INOTIFY_USER=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BOOTINFO_PROC=y
CONFIG_PROC_HARDWARE=y
