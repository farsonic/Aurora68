+static constexpr int MAC_MAIN_SND_BUF_OFFSET = (0x0300 >> 1);   // end of memory minus 0x0300
+static constexpr int MAC_ALT_SND_BUF_OFFSET  = (0x5F00 >> 1);   // end of memory minus 0x5F00
+static constexpr int MAC_MAIN_SCREEN_BUF_OFFSET = (0x5900 >> 1);
+static constexpr int MAC_ALT_SCREEN_BUF_OFFSET  = (0xD900 >> 1);
