new file mode 100644
index 00000000..a8f8a7f3
--- /dev/null
+++ b/src/mame/apple/bridge68k.h
@@ -0,0 +1,166 @@
+// license:BSD-3-Clause
+// copyright-holders:psmac project
+/****************************************************************************
+
+    bridge68k.h
+
+    "External CPU" placeholder for the psmac software testbed.
+
+    The device occupies the 68030 socket of a MAME Macintosh driver but does
+    not execute any code: an external emulator (Emu68 under QEMU) owns CPU,
+    RAM and ROM and forwards the bus cycles that would reach the motherboard
+    over a UNIX-domain stream socket.  bridge68k_device listens on that
+    socket and performs the requested accesses on its big-endian program
+    address space, exactly as the 68030 would have done (byte lanes, mirrors,
+    side effects).  See docs/05-bridge-protocol.md for the wire protocol.
+
+****************************************************************************/
+
+#ifndef MAME_APPLE_BRIDGE68K_H
+#define MAME_APPLE_BRIDGE68K_H
+
+#pragma once
+
+class bridge68k_device : public cpu_device
+{
+public:
+	// input line numbers, compatible with cpu/m68000 (m68kcommon.h / m68kmusashi.h)
+	static constexpr int IRQ_1 = 1;
+	static constexpr int IRQ_2 = 2;
+	static constexpr int IRQ_3 = 3;
+	static constexpr int IRQ_4 = 4;
+	static constexpr int IRQ_5 = 5;
+	static constexpr int IRQ_6 = 6;
+	static constexpr int IRQ_7 = 7;
+	static constexpr int LINE_BUSERROR = 16;
+
+	bridge68k_device(const machine_config &mconfig, const char *tag, device_t *owner, u32 clock);
+	virtual ~bridge68k_device();
+
+	// which motherboard this socket is in: the IIci's SCSI windows or the SE's need the
+	// reply held until the scheduler has delivered their HALT/BERR side effects
+	enum class board { IICI, SE };
+	void set_board(board b) { m_board = b; }
+
+	// read-only status for the driver / debugger
+	u8 ipl() const noexcept;
+	bool client_connected() const noexcept { return m_client_fd >= 0; }
+
+protected:
+	// a 68000 socket (16-bit data, 24-bit address): bridge68000_device below
+	bridge68k_device(const machine_config &mconfig, device_type type, const char *tag, device_t *owner, u32 clock, int data_width, int addr_width);
+
+	enum
+	{
+		BRIDGE68K_PC = 1,
+		BRIDGE68K_IPL,
+		BRIDGE68K_FLAGS
+	};
+
+	// device-level overrides
+	virtual void device_start() override;
+	virtual void device_reset() override;
+	virtual void device_stop() override;
+
+	// device_execute_interface overrides
+	virtual u32 execute_min_cycles() const noexcept override { return 1; }
+	virtual u32 execute_max_cycles() const noexcept override { return 4; }
+	virtual u32 execute_input_lines() const noexcept override { return 8; }
+	virtual bool execute_input_edge_triggered(int inputnum) const noexcept override { return inputnum == LINE_BUSERROR || inputnum == IRQ_7; }
+	virtual void execute_run() override;
+	virtual void execute_set_input(int inputnum, int state) override;
+
+	// device_memory_interface overrides
+	virtual space_config_vector memory_space_config() const override;
+
+	// device_state_interface overrides
+	virtual void state_export(const device_state_entry &entry) override;
+	virtual void state_string_export(const device_state_entry &entry, std::string &str) const override;
+
+	// device_disasm_interface overrides
+	virtual std::unique_ptr<util::disasm_interface> create_disassembler() override;
+
+private:
+	// wire protocol (docs/05-bridge-protocol.md)
+	static constexpr size_t REQ_SIZE = 12;
+	static constexpr size_t REPLY_SIZE = 8;
+	enum : u8 { OP_READ = 1, OP_WRITE = 2, OP_POLL = 3, OP_RESET_ACK = 4 };
+	enum : u8 { REQ_FLAG_POSTED = 0x01 };
+	enum : u8 { STATUS_OK = 0, STATUS_BUSERROR = 1, STATUS_BADREQ = 2 };
+	enum : u8 { REPLY_FLAG_RESET = 0x01, REPLY_FLAG_HALT = 0x02 };
+
+	static constexpr int ACCESS_CYCLES = 4;     // cycles charged per bus access
+	static constexpr int POLL_TIMEOUT_MS = 1;   // socket poll timeout when idle
+
+	void open_listener();
+	void close_listener();
+	void close_client();
+	void service_sockets(int timeout_ms);
+	bool take_request();
+	void send_reply(u8 status, u32 data);
+	void account_idle_time();
+	u8 reply_flags() const;
+
+	const address_space_config m_program_config;
+	const bool m_wide16;        // 16-bit data bus (68000 socket)
+	board m_board = board::IICI;
+	memory_access<32, 2, 0, ENDIANNESS_BIG>::specific m_program;     // 68030 socket: 32-bit data, 32-bit address
+	memory_access<24, 1, 0, ENDIANNESS_BIG>::specific m_program16;   // 68000 socket: 16-bit data, 24-bit address
+	u32 bus_read(u32 addr, u8 size);
+	void bus_write(u32 addr, u8 size, u32 data);
+
+	int m_icount;
+
+	// debugger-visible state
+	u32 m_pc;
+	u8  m_state_ipl;
+	u8  m_state_flags;
+
+	// input lines
+	u8   m_irq_mask;        // bits 1..7: asserted IRQ lines
+	bool access_needs_sync(u32 addr) const;
+	bool m_berr_hit;        // M68K_LINE_BUSERROR pulsed since the current access started
+	bool m_reset_req;       // device_reset() happened, not yet acknowledged by RESET_ACK
+
+	// socket state
+	std::string m_sock_path;
+	int m_listen_fd;
+	int m_client_fd;
+	// FIFO transport (PSMAC_BRIDGE_FIFO=req:rep): m_client_fd reads requests, m_reply_fd writes replies
+	bool m_fifo_mode = false;
+	int m_reply_fd = -1;
+	std::string m_fifo_req, m_fifo_rep;
+	u8 m_rxbuf[REQ_SIZE];
+	size_t m_rxlen;
+
+	// access in flight: reply is sent on the next execute_run() so that the
+	// scheduler has processed the (synchronised) input-line events the access caused
+	bool m_reply_pending;
+	u32  m_reply_data;
+	u8   m_reply_status;
+
+	// wall-clock tracking for idle cycle consumption
+	osd_ticks_t m_last_ticks;
+	u64 m_idle_credit;
+	u64 m_stat_requests;
+	u64 m_stat_connects;
+	u64 m_stat_runs;
+	u64 m_stat_polls;
+	u64 m_stat_sleeps;
+	u64 m_stat_cycles;
+	osd_ticks_t m_stat_inside;
+};
+
+DECLARE_DEVICE_TYPE(BRIDGE68K, bridge68k_device)
+
+// The same device in a 68000 socket: the Macintosh SE's. 16 data lines, 24 address lines,
+// which is also all a classic PiStorm carries; the external emulator still owns ROM and RAM.
+class bridge68000_device : public bridge68k_device
+{
+public:
+	bridge68000_device(const machine_config &mconfig, const char *tag, device_t *owner, u32 clock);
+};
+
+DECLARE_DEVICE_TYPE(BRIDGE68000, bridge68000_device)
+
+#endif // MAME_APPLE_BRIDGE68K_H
