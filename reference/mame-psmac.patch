+//**************************************************************************
+//  INPUT LINES
+//**************************************************************************
+
+void bridge68k_device::execute_set_input(int inputnum, int state)
+{
+	if (inputnum >= IRQ_1 && inputnum <= IRQ_7)
+	{
+		if (state != CLEAR_LINE)
+			m_irq_mask |= 1 << inputnum;
+		else
+			m_irq_mask &= ~(1 << inputnum);
+	}
+	else if (inputnum == LINE_BUSERROR)
+	{
+		// pulsed (ASSERT then CLEAR) by the motherboard during the access
+		if (state != CLEAR_LINE)
+			m_berr_hit = true;
+	}
+	// INPUT_LINE_HALT / INPUT_LINE_RESET never get here: handled by device_execute_interface
+}
+
