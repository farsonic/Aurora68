+//  CONSTRUCTION / DEVICE INTERFACE
+//**************************************************************************
+
+bridge68k_device::bridge68k_device(const machine_config &mconfig, const char *tag, device_t *owner, u32 clock) :
+	bridge68k_device(mconfig, BRIDGE68K, tag, owner, clock, 32, 32)
+{
+}
+
+bridge68000_device::bridge68000_device(const machine_config &mconfig, const char *tag, device_t *owner, u32 clock) :
+	bridge68k_device(mconfig, BRIDGE68000, tag, owner, clock, 16, 24)
+{
+	set_board(board::SE);
+}
+
+bridge68k_device::bridge68k_device(const machine_config &mconfig, device_type type, const char *tag, device_t *owner, u32 clock, int data_width, int addr_width) :
+	cpu_device(mconfig, type, tag, owner, clock),
+	m_program_config("program", ENDIANNESS_BIG, data_width, addr_width),
+	m_wide16(data_width == 16),
+	m_icount(0),
+	m_pc(0),
+	m_state_ipl(0),
+	m_state_flags(0),
+	m_irq_mask(0),
+	m_berr_hit(false),
+	m_reset_req(false),
+	m_listen_fd(-1),
+	m_client_fd(-1),
+	m_rxlen(0),
+	m_reply_pending(false),
+	m_reply_data(0),
+	m_reply_status(0),
+	m_last_ticks(0),
+	m_idle_credit(0),
+	m_stat_requests(0),
+	m_stat_connects(0),
+	m_stat_runs(0),
+	m_stat_polls(0),
+	m_stat_sleeps(0),
+	m_stat_cycles(0),
+	m_stat_inside(0)
+{
+	set_icountptr(m_icount);
+}
+
+bridge68k_device::~bridge68k_device()
+{
+	close_client();
+	close_listener();
+}
+
+device_memory_interface::space_config_vector bridge68k_device::memory_space_config() const
+{
+	return space_config_vector{ std::make_pair(AS_PROGRAM, &m_program_config) };
+}
+
+std::unique_ptr<util::disasm_interface> bridge68k_device::create_disassembler()
+{
+	return std::make_unique<bridge68k_disassembler>();
+}
+
+void bridge68k_device::device_start()
+{
+	if (m_wide16)
+		space(AS_PROGRAM).specific(m_program16);
+	else
+		space(AS_PROGRAM).specific(m_program);
+
+	const char *env = std::getenv("PSMAC_BRIDGE_SOCK");
+	if (const char *fifo = std::getenv("PSMAC_BRIDGE_FIFO"))
+	{
+		std::string f(fifo);
+		auto colon = f.find(':');
+		if (colon != std::string::npos)
+		{
+			m_fifo_mode = true;
+			m_fifo_req = f.substr(0, colon);
+			m_fifo_rep = f.substr(colon + 1);
+		}
+	}
+	m_sock_path = (env && *env) ? env : DEFAULT_SOCK_PATH;
+
+	state_add(BRIDGE68K_PC, "PC", m_pc).formatstr("%08X");
+	state_add(STATE_GENPC, "GENPC", m_pc).noshow();
+	state_add(STATE_GENPCBASE, "CURPC", m_pc).noshow();
+	state_add(BRIDGE68K_IPL, "IPL", m_state_ipl).callexport().formatstr("%1u");
+	state_add(BRIDGE68K_FLAGS, "FLAGS", m_state_flags).callexport().formatstr("%12s");
+	state_add(STATE_GENFLAGS, "GENFLAGS", m_state_flags).callexport().formatstr("%12s").noshow();
+
+	// the socket is created lazily on the first execute_run() so that
+	// -validate / -listxml and the like never touch the filesystem
+}
+
+void bridge68k_device::device_reset()
+{
+	m_pc = 0;
+	m_irq_mask = 0;
+	m_berr_hit = false;
+	m_idle_credit = 0;
+	m_last_ticks = 0;
+	// note: a pending reply / partially received request survives a reset so
+	// that the CPU side never waits forever
+
+	// tell the CPU side that the motherboard wants a reset (cleared by OP_RESET_ACK)
+	m_reset_req = true;
+}
+
+void bridge68k_device::device_stop()
+{
+	osd_printf_verbose("bridge68k: %llu requests over %llu connection(s); %llu execute_run calls, %llu polls (%llu with timeout), %llu cycles, %.3f s inside execute_run\n",
+			(unsigned long long)m_stat_requests, (unsigned long long)m_stat_connects, (unsigned long long)m_stat_runs,
+			(unsigned long long)m_stat_polls, (unsigned long long)m_stat_sleeps, (unsigned long long)m_stat_cycles,
+			double(m_stat_inside) / double(osd_ticks_per_second()));
+	close_client();
+	close_listener();
+}
+
+void bridge68k_device::state_export(const device_state_entry &entry)
+{
+	switch (entry.index())
+	{
+	case BRIDGE68K_IPL:
+		m_state_ipl = ipl();
+		break;
+
+	case BRIDGE68K_FLAGS:
+	case STATE_GENFLAGS:
+		m_state_flags = (m_reset_req ? 1 : 0) | (m_berr_hit ? 2 : 0) | (m_reply_pending ? 4 : 0) | ((m_client_fd >= 0) ? 8 : 0);
+		break;
+	}
+}
+
+void bridge68k_device::state_string_export(const device_state_entry &entry, std::string &str) const
+{
+	switch (entry.index())
+	{
+	case BRIDGE68K_IPL:
+		str = string_format("%u", ipl());
+		break;
+
+	case BRIDGE68K_FLAGS:
+	case STATE_GENFLAGS:
+		str = string_format("%s%s%s%s",
+				m_reset_req ? "R" : ".",
+				m_berr_hit ? "B" : ".",
+				m_reply_pending ? "P" : ".",
+				(m_client_fd >= 0) ? "C" : ".");
+		break;
+	}
+}
+
+u8 bridge68k_device::ipl() const noexcept
+{
+	for (int level = 7; level >= 1; level--)
+		if (BIT(m_irq_mask, level))
+			return level;
+	return 0;
+}
