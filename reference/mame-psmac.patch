+//**************************************************************************
+//  SOCKET HANDLING
+//**************************************************************************
+
+void bridge68k_device::open_listener()
+{
+	if (m_fifo_mode)
+	{
+		if (m_client_fd >= 0)
+			return;
+		::mkfifo(m_fifo_req.c_str(), 0666);
+		::mkfifo(m_fifo_rep.c_str(), 0666);
+		if (m_reply_fd < 0)
+			m_reply_fd = ::open(m_fifo_rep.c_str(), O_RDWR | O_CLOEXEC);   // O_RDWR: never blocks, keeps the FIFO alive
+		int fd = ::open(m_fifo_req.c_str(), O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+		if (fd < 0 || m_reply_fd < 0)
+		{
+			logerror("bridge68k: FIFO open failed: %s\n", std::strerror(errno));
+			return;
+		}
+		m_client_fd = fd;
+		m_rxlen = 0;
+		m_stat_connects++;
+		osd_printf_info("bridge68k: FIFO transport %s (requests) / %s (replies)\n", m_fifo_req, m_fifo_rep);
+		return;
+	}
+	if (m_listen_fd >= 0)
+		return;
+
+	int fd = ::socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+	if (fd < 0)
+	{
+		logerror("bridge68k: socket(): %s\n", std::strerror(errno));
+		return;
+	}
+
+	sockaddr_un addr;
+	std::memset(&addr, 0, sizeof(addr));
+	addr.sun_family = AF_UNIX;
+	if (m_sock_path.length() >= sizeof(addr.sun_path))
+	{
+		logerror("bridge68k: socket path too long: %s\n", m_sock_path);
+		::close(fd);
+		return;
+	}
+	std::strncpy(addr.sun_path, m_sock_path.c_str(), sizeof(addr.sun_path) - 1);
+
+	// remove a stale socket file (we are the only server)
+	struct stat st;
+	if (::lstat(m_sock_path.c_str(), &st) == 0 && S_ISSOCK(st.st_mode))
+		::unlink(m_sock_path.c_str());
+
+	if (::bind(fd, reinterpret_cast<const sockaddr *>(&addr), sizeof(addr)) < 0)
+	{
+		logerror("bridge68k: bind(%s): %s\n", m_sock_path, std::strerror(errno));
+		::close(fd);
+		return;
+	}
+	if (::listen(fd, 4) < 0)
+	{
+		logerror("bridge68k: listen(%s): %s\n", m_sock_path, std::strerror(errno));
+		::close(fd);
+		::unlink(m_sock_path.c_str());
+		return;
+	}
+	::fcntl(fd, F_SETFL, ::fcntl(fd, F_GETFL, 0) | O_NONBLOCK);
+
+	m_listen_fd = fd;
+	osd_printf_info("bridge68k: listening on %s\n", m_sock_path);
+}
+
+void bridge68k_device::close_listener()
+{
+	if (m_listen_fd >= 0)
+	{
+		::close(m_listen_fd);
+		m_listen_fd = -1;
+		::unlink(m_sock_path.c_str());
+	}
+}
+
+void bridge68k_device::close_client()
+{
+	if (m_client_fd >= 0)
+	{
+		::close(m_client_fd);
+		m_client_fd = -1;
+	}
+	m_rxlen = 0;
+	m_reply_pending = false;
+}
+
+void bridge68k_device::send_reply(u8 status, u32 data)
+{
+	if (m_client_fd < 0)
+		return;
+
+	u8 buf[REPLY_SIZE];
+	buf[0] = status;
+	buf[1] = ipl();
+	buf[2] = reply_flags();
+	buf[3] = 0;
+	put_u32le(&buf[4], data);
+
+	size_t done = 0;
+	while (done < REPLY_SIZE)
+	{
+		ssize_t n = m_fifo_mode ? ::write(m_reply_fd, buf + done, REPLY_SIZE - done)
+		                        : ::send(m_client_fd, buf + done, REPLY_SIZE - done, MSG_NOSIGNAL);
+		if (n < 0)
+		{
+			if (errno == EINTR)
+				continue;
+			if (errno == EAGAIN || errno == EWOULDBLOCK)
+			{
+				// the peer is not draining its socket; wait for it (bounded)
+				pollfd pfd = { m_client_fd, POLLOUT, 0 };
+				if (::poll(&pfd, 1, 1000) > 0)
+					continue;
+			}
+			LOGSOCK("bridge68k: send(): %s, dropping client\n", std::strerror(errno));
+			close_client();
+			return;
+		}
+		done += n;
+	}
+}
+
+u8 bridge68k_device::reply_flags() const
+{
+	u8 flags = 0;
+	if (m_reset_req)
+		flags |= REPLY_FLAG_RESET;
+	if (suspended(SUSPEND_REASON_HALT))
+		flags |= REPLY_FLAG_HALT;
+	return flags;
+}
+
+// Wait up to timeout_ms for socket activity, accept connections and buffer
+// incoming request bytes.  Never blocks longer than the timeout.
+void bridge68k_device::service_sockets(int timeout_ms)
+{
+	if (m_fifo_mode ? (m_client_fd < 0) : (m_listen_fd < 0))
+	{
+		open_listener();
+		if (m_fifo_mode ? (m_client_fd < 0) : (m_listen_fd < 0))
+		{
+			// could not create the socket: don't spin
+			if (timeout_ms > 0)
+				osd_sleep(osd_ticks_per_second() * timeout_ms / 1000);
+			return;
+		}
+	}
+
+	pollfd pfds[2];
+	int nfds = 0;
+	if (m_fifo_mode)
+	{
+		// FIFO: index 0 is the request descriptor; emulate the socket layout below
+		pfds[nfds++] = { -1, 0, 0 };
+		pfds[nfds++] = { m_client_fd, POLLIN, 0 };
+	}
+	else
+	{
+		pfds[nfds++] = { m_listen_fd, POLLIN, 0 };
+		if (m_client_fd >= 0)
+			pfds[nfds++] = { m_client_fd, POLLIN, 0 };
+	}
+
+	// if a complete request is already buffered there is nothing to wait for
+	if (m_rxlen >= REQ_SIZE)
+		timeout_ms = 0;
+
+	m_stat_polls++;
+	if (timeout_ms > 0)
+		m_stat_sleeps++;
+	// Idle wait: 200 us, not a whole millisecond. Emulated time advances by wall-clock credit,
+	// so the VIA timers that Mac OS calibrates against move in steps of this size while the
+	// client CPU runs without bus accesses; 1 ms steps made System 7.1's speed probe read zero.
+	int rc;
+	if (timeout_ms > 0)
+	{
+		struct timespec ts = { 0, 200000 };
+		rc = ::ppoll(pfds, nfds, &ts, nullptr);
+	}
+	else
+		rc = ::poll(pfds, nfds, 0);
+	if (rc <= 0)
+		return;
+
+	if (pfds[0].revents & POLLIN)
+	{
+		int fd = ::accept4(m_listen_fd, nullptr, nullptr, SOCK_NONBLOCK | SOCK_CLOEXEC);
+		if (fd >= 0)
+		{
+			if (m_client_fd >= 0)
+			{
+				// one client at a time: the newest connection wins
+				LOGSOCK("bridge68k: new client replaces the current one\n");
+				close_client();
+			}
+			m_client_fd = fd;
+			m_rxlen = 0;
+			m_stat_connects++;
+			osd_printf_info("bridge68k: client connected\n");
+			return; // poll again next time with the new descriptor
+		}
+	}
+
+	if (nfds > 1 && (pfds[1].revents & (POLLIN | POLLHUP | POLLERR)))
+	{
+		ssize_t n = m_fifo_mode ? ::read(m_client_fd, m_rxbuf + m_rxlen, REQ_SIZE - m_rxlen)
+		                        : ::recv(m_client_fd, m_rxbuf + m_rxlen, REQ_SIZE - m_rxlen, 0);
+		if (n > 0)
+			m_rxlen += n;
+		else if (n == 0 && m_fifo_mode)
+		{
+			// writer went away (QEMU restarted): reopen lazily
+			osd_printf_info("bridge68k: FIFO writer closed, waiting for a new one\n");
+			close_client();
+		}
+		else if (n == 0 || (errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR))
+		{
+			osd_printf_info("bridge68k: client disconnected%s%s\n", (n < 0) ? ": " : "", (n < 0) ? std::strerror(errno) : "");
+			close_client();
+		}
+	}
+}
+
+// Accesses whose side effects (HALT hold, BERR pulse) must reach the scheduler
+// before the reply goes out: the IIci SCSI register and pseudo-DMA windows
+// (0x50F06000, 0x50F10000, 0x50F12000; A20-A23 are not decoded in I/O space).
+bool bridge68k_device::access_needs_sync(u32 addr) const
+{
+	if (m_board == board::SE)
+		return (addr & 0xf80000) == 0x580000;       // the SE's 5380 and its pseudo-DMA window
+	if ((addr & 0xff000000) != 0x50000000)
+		return false;
+	const u32 off = addr & 0x000fffff;
+	return (off >= 0x06000 && off < 0x08000) || (off >= 0x10000 && off < 0x14000);
+}
+
+// the access itself, on whichever bus this socket has; a 32-bit access on the 16-bit bus is
+// two cycles, as the 68000 did it
+u32 bridge68k_device::bus_read(u32 addr, u8 size)
+{
+	if (m_wide16)
+	{
+		addr &= 0xffffff;
+		switch (size)
+		{
+		case 1: return m_program16.read_byte(addr);
+		case 2: return (addr & 1) ? m_program16.read_word_unaligned(addr) : m_program16.read_word(addr);
+		default: return (addr & 1) ? m_program16.read_dword_unaligned(addr) : m_program16.read_dword(addr);
+		}
+	}
+	switch (size)
+	{
+	case 1: return m_program.read_byte(addr);
+	case 2: return (addr & 1) ? m_program.read_word_unaligned(addr) : m_program.read_word(addr);
+	default: return (addr & 3) ? m_program.read_dword_unaligned(addr) : m_program.read_dword(addr);
+	}
+}
+
+void bridge68k_device::bus_write(u32 addr, u8 size, u32 data)
+{
+	if (m_wide16)
+	{
+		addr &= 0xffffff;
+		switch (size)
+		{
+		case 1: m_program16.write_byte(addr, data & 0xff); break;
+		case 2: if (addr & 1) m_program16.write_word_unaligned(addr, data & 0xffff); else m_program16.write_word(addr, data & 0xffff); break;
+		default: if (addr & 1) m_program16.write_dword_unaligned(addr, data); else m_program16.write_dword(addr, data); break;
+		}
+		return;
+	}
+	switch (size)
+	{
+	case 1: m_program.write_byte(addr, data & 0xff); break;
+	case 2: if (addr & 1) m_program.write_word_unaligned(addr, data & 0xffff); else m_program.write_word(addr, data & 0xffff); break;
+	default: if (addr & 3) m_program.write_dword_unaligned(addr, data); else m_program.write_dword(addr, data); break;
+	}
+}
+
+// Process one buffered request if complete.  Returns true if a bus access
+// was performed (the caller must then return from execute_run() so the
+// scheduler can deliver the input-line events the access caused).
+bool bridge68k_device::take_request()
+{
+	if (m_client_fd < 0 || m_rxlen < REQ_SIZE)
+		return false;
+
+	const u8 op = m_rxbuf[0];
+	const u8 size = m_rxbuf[1];
+	const u8 flags = m_rxbuf[2];
+	const u32 addr = get_u32le(&m_rxbuf[4]);
+	const u32 data = get_u32le(&m_rxbuf[8]);
+	m_rxlen = 0;
+	m_stat_requests++;
+
+	switch (op)
+	{
+	case OP_READ:
+	case OP_WRITE:
+	{
+		if (size != 1 && size != 2 && size != 4)
+		{
+			logerror("bridge68k: bad access size %u (op %u addr %08X)\n", size, op, addr);
+			send_reply(STATUS_BADREQ, 0);
+			return false;
+		}
+
+		m_pc = addr;
+		m_berr_hit = false;
+		u32 result = 0;
+
+		if (op == OP_READ)
+		{
+			result = bus_read(addr, size);
+			LOGPROTO("bridge68k: read%u  %08X -> %0*X\n", size * 8, addr, size * 2, result);
+		}
+		else
+		{
+			bus_write(addr, size, data);
+			LOGPROTO("bridge68k: write%u %08X <- %0*X%s\n", size * 8, addr, size * 2, data, (flags & REQ_FLAG_POSTED) ? " (posted)" : "");
+		}
+
+		m_icount -= ACCESS_CYCLES;
+
+		if (op == OP_WRITE && (flags & REQ_FLAG_POSTED))
+		{
+			// posted write: no reply; a bus error is lost (as on the real PiStorm)
+			m_reply_pending = false;
+		}
+		else if (access_needs_sync(addr))
+		{
+			// SCSI space: the access may have asserted HALT (pseudo-DMA FIFO fill, the
+			// DTACK wait) or pulsed BERR (timeout), both of which the scheduler only
+			// delivers after execute_run() returns. Hold the reply until the next slice
+			// (or, if HALT suspends this device, until the hold ends) so the client
+			// neither reads the FIFO early nor misses the bus error.
+			m_reply_pending = true;
+			m_reply_status = STATUS_OK;
+			m_reply_data = result;
+		}
+		else
+		{
+			// Reply immediately: waiting for the next scheduler slice cost ~1 ms per
+			// access (measured from Emu68/QEMU) when the device was idle-polling.
+			m_reply_pending = false;
+			send_reply(m_berr_hit ? STATUS_BUSERROR : STATUS_OK, result);
+			m_berr_hit = false;
+		}
+		return true;
+	}
+
+	case OP_POLL:
+		send_reply(STATUS_OK, 0);
+		return false;
+
+	case OP_RESET_ACK:
+		m_reset_req = false;
+		send_reply(STATUS_OK, 0);
+		return false;
+
+	default:
+		logerror("bridge68k: unknown op %u (size %u flags %02X addr %08X data %08X)\n", op, size, flags, addr, data);
+		send_reply(STATUS_BADREQ, 0);
+		return false;
+	}
+}
+
+
+//**************************************************************************
+//  EXECUTION
+//**************************************************************************
+
+// Convert elapsed wall-clock time into cycle credit, capped at 10 ms per step.
+void bridge68k_device::account_idle_time()
+{
+	const osd_ticks_t now = osd_ticks();
+	const osd_ticks_t tps = osd_ticks_per_second();
+	const u64 cap_cycles = u64(clock()) / 100; // 10 ms worth of cycles
+
+	if (m_last_ticks == 0 || now < m_last_ticks)
+	{
+		m_last_ticks = now;
+		return;
+	}
+
+	osd_ticks_t delta = now - m_last_ticks;
+	const osd_ticks_t cap_ticks = tps / 100;
+	if (delta > cap_ticks)
+	{
+		// we fell behind (e.g. the CPU was held, or the host was busy): drop the excess
+		delta = cap_ticks;
+		m_last_ticks = now - cap_ticks;
+	}
+
+	const u64 cycles = (u64(delta) * clock()) / tps;
+	if (cycles != 0)
+	{
+		// only consume the ticks that correspond to whole cycles, keep the remainder
+		m_last_ticks += (cycles * tps) / clock();
+		m_idle_credit = std::min<u64>(m_idle_credit + cycles, cap_cycles);
+	}
+}
+
+void bridge68k_device::execute_run()
+{
+	const osd_ticks_t t_in = osd_ticks();
+	const int icount_in = m_icount;
+	m_stat_runs++;
+	// complete the access performed in the previous call: by now the scheduler
+	// has delivered any bus-error pulse (and HALT hold) that it caused
+	if (m_reply_pending)
+	{
+		m_reply_pending = false;
+		send_reply(m_berr_hit ? STATUS_BUSERROR : m_reply_status, m_reply_data);
+		m_berr_hit = false;
+	}
+
+	while (m_icount > 0)
+	{
+		debugger_instruction_hook(m_pc);
+
+		account_idle_time();
+
+		// Sleep in poll() unless emulated time lags wall-clock time by at least
+		// one poll period.  (Skipping the sleep whenever credit > 0 would busy-wait:
+		// wall-clock time keeps accruing credit while we spin.)  poll() returns
+		// early when a request arrives, so request latency is not affected.
+		const u64 cycles_per_poll = u64(clock()) / 5000;   // 200 us of cycles
+		const int timeout_ms = (m_idle_credit >= cycles_per_poll) ? 0 : POLL_TIMEOUT_MS;
+		service_sockets(timeout_ms);
+
+		const bool served = take_request();
+
+		// A held reply means the access needs the scheduler to run (HALT/BERR
+		// delivery): give the slice back now, keeping the unused cycles.
+		if (m_reply_pending)
+			break;
+
+		// Emulated time must follow wall-clock time even while requests stream in,
+		// otherwise SCC transmits, VIA timers and interrupts never happen for a busy
+		// CPU: consume the accrued credit on every iteration, then keep serving.
+		if (m_idle_credit > 0)
+		{
+			const s32 take = s32(std::min<u64>(m_idle_credit, u64(m_icount)));
+			m_icount -= take;
+			m_idle_credit -= take;
+		}
+		if (served)
+			continue;
+	}
+	m_stat_cycles += icount_in - m_icount;
+	m_stat_inside += osd_ticks() - t_in;
+}
