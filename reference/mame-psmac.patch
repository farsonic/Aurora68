+#include <fcntl.h>
+#include <poll.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+#define LOG_PROTO   (1U << 1)
+#define LOG_SOCK    (1U << 2)
+
+#define VERBOSE (LOG_SOCK)
+#include "logmacro.h"
+
+#define LOGPROTO(...) LOGMASKED(LOG_PROTO, __VA_ARGS__)
+#define LOGSOCK(...)  LOGMASKED(LOG_SOCK, __VA_ARGS__)
+
+DEFINE_DEVICE_TYPE(BRIDGE68K, bridge68k_device, "bridge68k", "psmac bridge 68030 socket (external CPU over UNIX socket)")
+DEFINE_DEVICE_TYPE(BRIDGE68000, bridge68000_device, "bridge68000", "psmac bridge 68000 socket (external CPU over UNIX socket)")
+
+namespace {
+
+static constexpr char DEFAULT_SOCK_PATH[] = "/tmp/psmac-bridge.sock";
+
+class bridge68k_disassembler : public util::disasm_interface
+{
+public:
+	bridge68k_disassembler() = default;
+	virtual ~bridge68k_disassembler() = default;
+
+	virtual u32 opcode_alignment() const override { return 2; }
+	virtual offs_t disassemble(std::ostream &stream, offs_t pc, const data_buffer &opcodes, const data_buffer &params) override
+	{
+		util::stream_format(stream, "dc.w    $%04x    ; bridge68k: code runs in the external CPU", opcodes.r16(pc));
+		return 2 | SUPPORTED;
+	}
+};
+
+inline u32 get_u32le(const u8 *p) { return u32(p[0]) | (u32(p[1]) << 8) | (u32(p[2]) << 16) | (u32(p[3]) << 24); }
+inline void put_u32le(u8 *p, u32 v) { p[0] = v & 0xff; p[1] = (v >> 8) & 0xff; p[2] = (v >> 16) & 0xff; p[3] = (v >> 24) & 0xff; }
+
+} // anonymous namespace
