	(footprint "aurora68:Aurora68_PiSocket_2x20_Inverted"
		(layer "F.Cu")
		(uuid "71e5c4d7-253c-55d1-8c1c-3d144559da49")
		(at 50.37 115.13)
		(descr "2x20 female socket, 2.54 mm, 6.0 mm body, for a Raspberry Pi 3A+ or Zero 2 W plugged in components-down. Pin numbers are the Pi's; the pattern is the Pi's header seen from above with the Pi turned over about its short axis, so it is the mirror image of an ordinary Pi HAT socket. Open-bottom contacts: the Pi's 6.0 mm pins must seat fully (README, \"The Pi\").")
